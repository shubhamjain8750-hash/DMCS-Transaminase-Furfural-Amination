# ==================================================
# Radius of Gyration (Rg) and SASA
# cv-tam Validation Workflow
# ==================================================

parm solv_complexN.prmtop

trajin md1.nc 1 last 10

autoimage
center :1-330 mass origin

reference md1.rst7 parm solv_complexN.prmtop

# ==================================================
# Radius of Gyration
# ==================================================

radgyr :1-330 \
out Rg_protein_last10.dat

radgyr :1-330,UNI,UNL,UNP \
out Rg_complex_all_last10.dat

radgyr :1-330,UNI \
out Rg_protein_UNI_complex_last10.dat

radgyr :1-330,UNL \
out Rg_protein_UNL_complex_last10.dat

radgyr :1-330,UNP \
out Rg_protein_UNP_complex_last10.dat

# ==================================================
# SASA
# ==================================================

surf :1-330 \
out SASA_protein_last10.dat

surf :1-330,UNI,UNL,UNP \
out SASA_complex_all_last10.dat

surf :1-330,UNI \
out SASA_protein_UNI_complex_last10.dat

surf :1-330,UNL \
out SASA_protein_UNL_complex_last10.dat

surf :1-330,UNP \
out SASA_protein_UNP_complex_last10.dat

run
quit
